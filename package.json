{
  "name": "portfolio-web",
  "version": "0.1.0",
  "private": true,
  "description": "Immersive portfolio of Phatcharadanai Kanyapan: a working-studio exhibition of real engineering work.",
  "scripts": {
    "dev": "next dev",
    "build": "npm run content:verify && next build",
    "start": "serve out -l 4173 --no-clipboard",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "e2e": "playwright test",
    "content:verify": "tsx scripts/verify-content.ts",
    "content:scan": "tsx scripts/scan-secrets.ts",
    "media": "tsx scripts/optimize-media.ts",
    "resume:pdf": "tsx scripts/resume-pdf.ts",
    "lighthouse": "tsx scripts/lighthouse.ts",
    "submission:audit": "tsx scripts/capture-submission.ts",
    "verify": "npm run typecheck && npm run lint && npm test && npm run build && npm run content:scan && npm run e2e"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "^5.3.0",
    "@fontsource-variable/hanken-grotesk": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "@types/three": "^0.186.0",
    "lenis": "^1.3.27",
    "next": "^16.4.3",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "shiki": "^4.5.0",
    "three": "^0.186.1",
    "zod": "^4.6.7",
    "zustand": "^5.0.16"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^10.13.0",
    "eslint-config-next": "^16.4.3",
    "lighthouse": "^13.5.0",
    "prettier": "^3.9.10",
    "serve": "^14.2.6",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.5"
  },
  "type": "module"
}
